# ─────────────────────────────────────────────────────────────────────────────
#  Gunaso — Environment Variables Template (Docker Compose stack)
#  Copy this file to .env and fill in real values before starting the stack.
#  NEVER commit .env to version control.
#
#  Generate strong keys:
#    python -c "import secrets; print(secrets.token_urlsafe(64))"
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────────────────
# Set DEBUG=False in production. With DEBUG=False, SECRET_KEY is REQUIRED.
DEBUG=True
SECRET_KEY=change-me-generate-50-plus-random-chars
JWT_SIGNING_KEY=change-me-generate-a-separate-random-key
# With DEBUG=True, *.ngrok-free.app / *.ngrok.app / *.ngrok.io hosts are
# accepted automatically (dev tunnels). In production list every host here.
ALLOWED_HOSTS=localhost,127.0.0.1

# Behind plain-HTTP nginx in local dev keep this False.
# Set to True in production once TLS is terminated in front of the stack.
SECURE_SSL_REDIRECT=False

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
# The backend's DATABASE_URL is assembled from these values in docker-compose.yml.
POSTGRES_DB=gunaso_db
POSTGRES_USER=gunaso_user
POSTGRES_PASSWORD=change-me-db-password

# ── CORS / CSRF ───────────────────────────────────────────────────────────────
# Explicit allowlists. Add your production domain(s) here.
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost,http://localhost:3000

# ── Uploads ───────────────────────────────────────────────────────────────────
MAX_ATTACHMENT_SIZE_MB=10

# ── AI features (optional — classification, sujhav, reports) ────────────────
# Leave unset to run with AI features disabled; the app works fully without it.
# ANTHROPIC_API_KEY=sk-ant-...

# ── Email (optional — defaults to console backend) ───────────────────────────
# Needed for password reset, staff invites and email verification to actually
# leave the server. With Gmail, EMAIL_HOST_PASSWORD must be a 16-character App
# Password (https://myaccount.google.com/apppasswords), not the account password.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL defaults to EMAIL_HOST_USER when unset.
# DEFAULT_FROM_EMAIL=noreply@gunaso.gov.np
# EMAIL_TIMEOUT=15

# ── Password reset ───────────────────────────────────────────────────────────
# The SPA origin emailed links point at, and how long those links stay valid
# (seconds, default 24h).
# FRONTEND_URL=http://localhost:3000
# PASSWORD_RESET_TIMEOUT=86400

# ── Citizen notifications, SLA targets, contact form ────────────────────────
# Lifecycle emails (receipt + private follow-up link, status changes, staff
# replies) go out after commit on a background thread. Anonymous submitters
# are never emailed.
# NOTIFICATIONS_ASYNC=True
# A gunaso still 'submitted' after SLA_RESPONSE_HOURS, or open past
# SLA_RESOLUTION_DAYS, is flagged overdue to the organization.
# SLA_RESPONSE_HOURS=72
# SLA_RESOLUTION_DAYS=30
# Optional mailbox that also receives public contact-form messages (they are
# always stored in the superadmin inbox regardless).
# CONTACT_NOTIFY_EMAIL=
# THROTTLE_FOLLOWUP=20/hour
# THROTTLE_CONTACT=5/hour
