# Native (Capacitor) build: the app is served from https://localhost inside the
# WebView, so the API and public links must be absolute. Requests go through
# CapacitorHttp (native), which bypasses CORS and keeps the httpOnly refresh
# cookie in the native cookie jar.
VITE_API_BASE_URL=https://gunaaso.com/api/v1
VITE_PUBLIC_URL=https://gunaaso.com
